{
  "expo": {
    "name": "Brandschutz Ried",
    "slug": "brandschutz-ried",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brandschutzried",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "de.brandschutzried.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Die Kamera wird genutzt, um Mängel bei Brandschutzbegehungen zu fotografieren.",
        "NSPhotoLibraryUsageDescription": "Fotos aus der Mediathek können als Mängelbilder an eine Begehung angehängt werden."
      }
    },
    "android": {
      "package": "de.brandschutzried.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Die Kamera wird genutzt, um Mängel bei Brandschutzbegehungen zu fotografieren.",
          "photosPermission": "Fotos aus der Mediathek können als Mängelbilder an eine Begehung angehängt werden."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A6B44"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}