# Öffentliche Adresse der Website (für Sitemap, Canonical-URLs, Formular-Herkunftsprüfung)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Empfänger und Absender für Anfragen aus dem Kontaktformular
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Variante A (empfohlen, DSGVO-freundlich): SMTP des eigenen Mail-Anbieters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true bei Port 465
SMTP_SECURE=false

# Variante B: Resend (API). Nur nutzen, wenn ein AV-Vertrag vorliegt.
RESEND_API_KEY=
